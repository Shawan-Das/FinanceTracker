# =============================================================================
# Personal Finance Tracker — Environment Variables
# =============================================================================

# Database
DATABASE_URL=postgresql://user:password@host:5432/finance_tracker

# Session
SESSION_SECRET=change-this-to-a-secure-random-string

# Server
NODE_ENV=development
PORT=3001

# CORS — the frontend URL (for cross-origin requests)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=

# Email (for verification codes)
# For development, codes are logged to console if SMTP is not configured
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Finance Tracker <noreply@financetracker.com>

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=10
VERIFICATION_CODE_EXPIRY_MINUTES=15
