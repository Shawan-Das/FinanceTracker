# =============================================================================
# Personal Finance Tracker — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before deploying.
#
# For single-server deployment, the Express server serves BOTH the API
# and the React frontend from the same URL (e.g. https://finance.example.com).
# =============================================================================

# Database
DATABASE_URL=postgresql://user:password@host:5432/finance_tracker

# Session — generate a strong random string (e.g. openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-secure-random-string

# Server
NODE_ENV=production
PORT=3000

# CORS — in production, same-origin requests don't need CORS.
# Only set this if you need cross-origin access during testing.
CORS_ORIGIN=
FRONTEND_URL=

# Email (for verification codes)
# If not configured, codes are logged to console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Finance Tracker <noreply@yourdomain.com>

# Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=10
VERIFICATION_CODE_EXPIRY_MINUTES=15
